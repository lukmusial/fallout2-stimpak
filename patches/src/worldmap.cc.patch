@@ -7461,6 +7461,80 @@ int wmMapMusicStart()
     return -1;
 }
 
+int wmStimpakGetAreaCount()
+{
+    return wmMaxAreaNum;
+}
+
+bool wmStimpakAreaHasEntrance(City areaIdx)
+{
+    return cityIsValid(areaIdx) && wmAreaInfoList[areaIdx].entrancesLength > 0;
+}
+
+int wmStimpakGetAreaState(City areaIdx)
+{
+    switch (wmAreaVisitedState(areaIdx)) {
+    case VisitedState::Visited:
+        return 2;
+    case VisitedState::Known:
+    case VisitedState::KnownFo1:
+        return 1;
+    default:
+        return 0;
+    }
+}
+
+void wmStimpakSetAreaState(City areaIdx, int state)
+{
+    if (!cityIsValid(areaIdx)) {
+        return;
+    }
+
+    if (state <= 0) {
+        wmAreaSetVisibleState(areaIdx, CITY_STATE_UNKNOWN, true);
+        wmAreaInfoList[areaIdx].visitedState = VisitedState::Unknown;
+        return;
+    }
+
+    wmAreaSetVisibleState(areaIdx, CITY_STATE_KNOWN, true);
+    // Marking Visited straight from Unknown only reaches Known; go through Known.
+    wmAreaMarkVisitedState(areaIdx, VisitedState::Known);
+    if (state >= 2) {
+        wmAreaMarkVisitedState(areaIdx, VisitedState::Visited);
+    }
+}
+
+int wmStimpakTravelToArea(City areaIdx)
+{
+    if (!wmStimpakAreaHasEntrance(areaIdx)) {
+        return -1;
+    }
+
+    wmStimpakSetAreaState(areaIdx, 2);
+
+    City previousArea = wmGenData.currentAreaId;
+    wmGenData.currentAreaId = areaIdx;
+
+    MapTransition transition;
+    int rc = wmAreaFindFirstValidMap(&transition.map, &transition.elevation, &transition.tile, &transition.rotation);
+    // The map transition teleports the party on the world map only when the
+    // current area differs, so put the old one back first.
+    wmGenData.currentAreaId = previousArea;
+    if (rc == -1) {
+        return -1;
+    }
+
+    if (transition.tile == -1) {
+        // The map's own start position, as a first visit from the world map.
+        transition.elevation = ELEVATION_FIRST;
+        transition.rotation = ROTATION_NE;
+    }
+
+    mapSetTransition(&transition);
+    mapHandleTransition();
+    return mapGetCurrentMap() == transition.map ? 0 : -1;
+}
+
