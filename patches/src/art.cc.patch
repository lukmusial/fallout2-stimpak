+static std::vector<std::pair<std::string, ArtGenerator>>& artGenerators()
+{
+    static std::vector<std::pair<std::string, ArtGenerator>> generators;
+    return generators;
+}
+
+void artRegisterGenerator(const char* fileName, ArtGenerator generator)
+{
+    artGenerators().emplace_back(fileName, generator);
+}
+
+// Art from a registered generator, matched on the file name (any case).
+static Art* artLoadGenerated(const char* path)
+{
+    const char* fileName = path;
+    for (const char* ch = path; *ch != '\0'; ch++) {
+        if (*ch == '\\' || *ch == '/') {
+            fileName = ch + 1;
+        }
+    }
+
+    for (const auto& [name, generator] : artGenerators()) {
+        if (compat_stricmp(name.c_str(), fileName) != 0) {
+            continue;
+        }
+
+        int width = 0;
+        int height = 0;
+        std::vector<unsigned char> pixels;
+        if (!generator(&width, &height, &pixels) || width <= 0 || height <= 0
+            || pixels.size() != static_cast<size_t>(width) * static_cast<size_t>(height)) {
+            debugPrint("ART: generator for %s failed\n", fileName);
+            return nullptr;
+        }
+
+        unsigned char* frameData = nullptr;
+        Art* art = artAllocateSingleFrame(width, height, &frameData);
+        if (art != nullptr) {
+            memcpy(frameData, pixels.data(), pixels.size());
+        }
+        return art;
+    }
+
+    return nullptr;
+}
